# Copy this file to backend/.env and fill in your values. Never commit .env.

DJANGO_DEBUG=true
# Generate one with: .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# https://aistudio.google.com/apikey  (leave empty to use the built-in rule-based stylist)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# https://serpapi.com/manage-api-key  (leave empty and "shop the gap" returns store search links)
SERPAPI_KEY=
# Google Shopping country/language, e.g. in/en, us/en, gb/en
SHOPPING_COUNTRY=in
SHOPPING_LANGUAGE=en

# Password reset emails. Leave EMAIL_HOST empty to print them in the Django terminal.
FRONTEND_URL=http://localhost:5173
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Inside & Out <no-reply@example.com>

# Production only
# DJANGO_DEBUG=false
# DATABASE_URL=postgres://user:password@host:5432/inside_out
